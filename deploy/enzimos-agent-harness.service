[Unit]
Description=enzimOS agent sessions and tool harness
Documentation=file:/usr/share/doc/enzimos-agent-harness/README.md
ConditionPathExists=%E/enzimos/agent-harness.json

[Service]
Type=simple
ExecStart=/usr/bin/enzimos-agent-harness --config %E/enzimos/agent-harness.json --socket %t/enzimos-agent-harness/service.sock --state %S/enzimos-agent-harness
RuntimeDirectory=enzimos-agent-harness
RuntimeDirectoryMode=0700
StateDirectory=enzimos-agent-harness
StateDirectoryMode=0700
Environment=XDG_CONFIG_HOME=%E XDG_STATE_HOME=%S
UMask=0077
NoNewPrivileges=yes
LimitCORE=0
TasksMax=96
MemoryMax=512M
MemorySwapMax=64M
CPUQuota=100%
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=3

# Start explicitly after configuring an enabled provider/workspace profile.
# No install target: shipping the package does not enable agents.
